<mxCell id="package-diagram-color_PKG_FE_ADMIN" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/pages/admin &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Manager Portal UI»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;ReportsAnalyticsPage.jsx (KPIs &amp; Excel)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;TableManagementPage.jsx, MenuManagementPage.jsx&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;StaffManagementPage.jsx (PIN &amp; Weekly Roster)&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=155;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1640" y="356" width="340" height="104" as="geometry"/></mxCell>
<mxCell id="package-diagram-color_PKG_FE_COMP" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/components (layout, common, customer, admin) &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Shared UI &amp; Guards»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;layout/: CustomerLayout.jsx, StaffLayout.jsx, AdminLayout.jsx&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;common/: ProtectedRoute.jsx (RBAC Guard), NotificationBell.jsx, ConnectionStatusBar.jsx, RomsLogo.jsx, Icon.jsx&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;customer/: CustomerAiChatModal.jsx (AI Assistant)   |   admin/: ShiftStatusWidget.jsx (30s Heartbeat), RestaurantProfileModal.jsx&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=265;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1280" y="586" width="700" height="116" as="geometry"/></mxCell>
<mxCell id="package-diagram-color_PKG_FE_API" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/api &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Axios REST Layer»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;axiosClient.js (JWT Interceptor)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;authApi, customerApi, customerAiApi,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;reservationApi, waiterApi, kitchenApi,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;cashierApi, paymentApi, tableApi,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;zoneApi, menuApi, staffApi, reportApi&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=130;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1280" y="774" width="245" height="152" as="geometry"/></mxCell>
<mxCell id="package-diagram-color_PKG_FE_UTILS" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/utils &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Sync &amp; Helpers»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;realtimeSync.js&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  (STOMP WebSocket Sub)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;tableStandeeGenerator.js&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  (QR Standee ZIP)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;restaurantConfig.js&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=125;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1545" y="774" width="205" height="152" as="geometry"/></mxCell>
<mxCell id="package-diagram-color_PKG_FE_CTX" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/context &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«React Context»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;AuthContext.jsx&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  (Staff JWT &amp; Shift State)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;CartContext.jsx&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  (At-Table Order Batch)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;DialogContext.jsx&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=130;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1770" y="774" width="210" height="152" as="geometry"/></mxCell>
<mxCell id="package-diagram-color_NOTE_BE" value="&lt;div style=&quot;text-align:left;padding:6px 10px;line-height:1.42;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;margin-bottom:3px;&quot;&gt;Backend Architectural Governance &amp; Design Principles:&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;• Strict Unidirectional Layered Dependency: controller -&gt; service (interface) &lt;- serviceImpl -&gt; repository -&gt; entity (Domain Entities are never exposed directly to client APIs).&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;• Dual Token Security &amp; Concurrency Control: Staff JWT + Shift Schedule enforcement via JwtAuthenticationFilter; @Version optimistic locking &amp; 3-tier Reservation Lock (T-60m to T+45m).&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;• Event-Driven Realtime Push: State mutations in ServiceImpl trigger RealtimeServiceImpl (STOMP /topic/*) and HMAC-SHA256 verified PayOS Webhooks.&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#000000;strokeWidth=1.3;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="958" width="1062" height="110" as="geometry"/></mxCell>
<mxCell id="package-diagram-color_NOTE_FE" value="&lt;div style=&quot;text-align:left;padding:6px 10px;line-height:1.42;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;margin-bottom:3px;&quot;&gt;Frontend Component &amp; State Governance:&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;• Role-Isolated Workspaces: Customer (/dining/*), Waiter (/waiter/*), Kitchen KDS (/kitchen/*),&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  Cashier POS (/pos/*), and Manager Admin (/admin/*) strictly guarded by ProtectedRoute.&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;• Dual Channel: Axios REST Client (axiosClient.js) for state commands + STOMP WebSocket (realtimeSync.js).&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#000000;strokeWidth=1.3;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1280" y="958" width="700" height="110" as="geometry"/></mxCell>
