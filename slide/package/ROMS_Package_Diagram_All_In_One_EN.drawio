<mxCell id="package-diagram-mono_LH_FE_3" value="3. API Client, Realtime Sync &amp; Context (src/api, src/utils, src/context)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1280" y="750" width="680" height="22" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_CTRL" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;com.romsteam.roms.controller &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«REST Controllers»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;Public &amp; Customer: AuthController, CustomerDiningController, CustomerAiChatController, CustomerReservationController, CustomerTableController&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;FOH, Kitchen &amp; POS: WaiterController, KitchenController, CashierController, PaymentController (PayOS Webhook)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;BOH Admin Portal: AdminTableController, AdminZoneController, AdminReservationController, AdminMenuController, AdminStaffController, ReportController, RestaurantProfileController&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=240;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="144" width="1062" height="126" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_SEC" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;com.romsteam.roms.security &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Security Filters»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;JwtAuthenticationFilter (Staff &amp; Dining JWT)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;JwtTokenProvider (HS256 Signing &amp; Claims)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;TraceIdFilter (MDC Request Correlation)&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=190;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="336" width="324" height="124" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_CFG" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;com.romsteam.roms.config &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Spring Config»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;SecurityConfig (RBAC FilterChain &amp; CORS)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;WebSocketConfig (STOMP /ws &amp; /topic)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;CacheConfig, WebMvcConfig, AppConfig&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=185;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="429" y="336" width="324" height="124" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_EXC" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;com.romsteam.roms.exception &amp; actuator &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Cross-Cutting»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;GlobalExceptionHandler (@RestControllerAdvice)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;AppException, ResourceNotFoundException&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;RestaurantOperationalHealthIndicator&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=215;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="798" y="336" width="324" height="124" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_SVC" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;com.romsteam.roms.service &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Service Interfaces»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;AuthService, CustomerDiningService, CustomerAiService&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;ReservationService, WaiterService, KitchenService&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;CashierService, PayOsService, RealtimeService&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;MenuService, RestaurantTableService, ZoneService&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;StaffService, ReportService, NotificationService&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=190;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="524" width="324" height="176" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_SVC_IMPL" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;com.romsteam.roms.service.serviceImpl &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Impl»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;AuthServiceImpl, CustomerDiningServiceImpl,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;ReservationServiceImpl, WaiterServiceImpl,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;KitchenServiceImpl, CashierServiceImpl,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;PayOsServiceImpl (HMAC), RealtimeServiceImpl,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;MenuServiceImpl, StaffServiceImpl, ReportServiceImpl&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=230;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="429" y="524" width="324" height="176" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_DTO" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;com.romsteam.roms.dto &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«request &amp; response»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;request/: LoginRequest, CustomerPlaceOrderRequest,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  CreateReservationRequest, OpenTableRequest,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  UpdateKitchenStatusRequest, CashierCheckoutRequest&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;response/: ApiResponse&lt;T&gt;, AuthResponse,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  KdsOrderTicketResponse, BillSummaryResponse&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=220;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="798" y="524" width="324" height="176" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_REPO" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;com.romsteam.roms.repository &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Spring Data JPA»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;Floor &amp; Booking: ZoneRepository, RestaurantTableRepository,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  ReservationRepository, ReservationItemRepository, ServiceRequestRepository&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;Catalog &amp; Dining: CategoryRepository, MenuItemRepository, DiningSessionRepository&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;Orders, Billing &amp; Staff: OrderRepository, OrderItemRepository, BillRepository,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  StaffRepository, StaffScheduleRepository, RestaurantProfileRepository&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=210;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="774" width="505" height="152" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_ENT" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;com.romsteam.roms.entity &amp; entity.enums &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«JPA Domain Model (14 Tables)»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;Entities: Zone, RestaurantTable, Reservation, ReservationItem, Category, MenuItem,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  DiningSession, Order, OrderItem, Bill, ServiceRequest, Staff, StaffSchedule, RestaurantProfile&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;Enums: TableStatus, ReservationStatus, SessionStatus, OrderStatus, OrderItemStatus,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  BillStatus, PaymentMethod, PaymentStatus, UserRole, ShiftType&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=235;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="617" y="774" width="505" height="152" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_FE_ROUTES" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/routes &amp; src/pages/public + auth &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Router &amp; Entry Pages»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;AppRoutes.jsx (Role Guard &amp; Lazy Routes)  |  public/: LandingPage.jsx, ReservationPage.jsx  |  auth/: StaffLoginPage.jsx&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=210;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1280" y="144" width="700" height="78" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_FE_CUST" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/pages/customer &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«QR Dining UI»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;TableWelcomePage.jsx (QR Gate)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;CustomerMenuPage.jsx, CustomerCartPage.jsx&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;CustomerTrackingPage.jsx (Live Progress)&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=165;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1280" y="238" width="340" height="104" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_FE_WAITER" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/pages/waiter &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Waiter Tablet UI»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;WaiterFloorPlanPage.jsx (Live Table Map)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;WaiterOrderDetailPage.jsx (Open, Serve,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  Proxy Order, Transfer/Merge, Clean)&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=155;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1640" y="238" width="340" height="104" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_FE_KDS_POS" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/pages/kitchen &amp; cashier &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«KDS &amp; Cashier POS»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;kitchen/: KitchenKdsPage.jsx (Kanban &amp; 86 Toggle)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;cashier/: PosCheckoutPage.jsx (8% VAT Bill,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  Manager PIN Override, PayOS VietQR, Shift Drawer)&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=195;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1280" y="356" width="340" height="104" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_FE_ADMIN" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/pages/admin &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Manager Portal UI»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;ReportsAnalyticsPage.jsx (KPIs &amp; Excel)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;TableManagementPage.jsx, MenuManagementPage.jsx&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;StaffManagementPage.jsx (PIN &amp; Weekly Roster)&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=155;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1640" y="356" width="340" height="104" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_FE_COMP" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/components (layout, common, customer, admin) &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Shared UI &amp; Guards»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;layout/: CustomerLayout.jsx, StaffLayout.jsx, AdminLayout.jsx&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;common/: ProtectedRoute.jsx (RBAC Guard), NotificationBell.jsx, ConnectionStatusBar.jsx, RomsLogo.jsx, Icon.jsx&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;customer/: CustomerAiChatModal.jsx (AI Assistant)   |   admin/: ShiftStatusWidget.jsx (30s Heartbeat), RestaurantProfileModal.jsx&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=265;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1280" y="586" width="700" height="116" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_FE_API" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/api &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Axios REST Layer»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;axiosClient.js (JWT Interceptor)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;authApi, customerApi, customerAiApi,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;reservationApi, waiterApi, kitchenApi,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;cashierApi, paymentApi, tableApi,&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;zoneApi, menuApi, staffApi, reportApi&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=130;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1280" y="774" width="245" height="152" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_FE_UTILS" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/utils &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«Sync &amp; Helpers»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;realtimeSync.js&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  (STOMP WebSocket Sub)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;tableStandeeGenerator.js&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  (QR Standee ZIP)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;restaurantConfig.js&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=125;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1545" y="774" width="205" height="152" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_PKG_FE_CTX" value="&lt;div style=&quot;text-align:left;padding:4px 8px;line-height:1.38;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;&quot;&gt;src/context &lt;span style=&quot;font-weight:normal;font-style:italic;font-size:10.5px;color:#444444;&quot;&gt;«React Context»&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;AuthContext.jsx&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  (Staff JWT &amp; Shift State)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;CartContext.jsx&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  (At-Table Order Batch)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;DialogContext.jsx&lt;/div&gt;&lt;/div&gt;" style="shape=folder;fontStyle=1;tabWidth=130;tabHeight=22;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1770" y="774" width="210" height="152" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_NOTE_BE" value="&lt;div style=&quot;text-align:left;padding:6px 10px;line-height:1.42;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;margin-bottom:3px;&quot;&gt;Backend Architectural Governance &amp; Design Principles:&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;• Strict Unidirectional Layered Dependency: controller -&gt; service (interface) &lt;- serviceImpl -&gt; repository -&gt; entity (Domain Entities are never exposed directly to client APIs).&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;• Dual Token Security &amp; Concurrency Control: Staff JWT + Shift Schedule enforcement via JwtAuthenticationFilter; @Version optimistic locking &amp; 3-tier Reservation Lock (T-60m to T+45m).&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;• Event-Driven Realtime Push: State mutations in ServiceImpl trigger RealtimeServiceImpl (STOMP /topic/*) and HMAC-SHA256 verified PayOS Webhooks.&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#000000;strokeWidth=1.3;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="958" width="1062" height="110" as="geometry"/></mxCell>
<mxCell id="package-diagram-mono_NOTE_FE" value="&lt;div style=&quot;text-align:left;padding:6px 10px;line-height:1.42;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#000000;margin-bottom:3px;&quot;&gt;Frontend Component &amp; State Governance:&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;• Role-Isolated Workspaces: Customer (/dining/*), Waiter (/waiter/*), Kitchen KDS (/kitchen/*),&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;  Cashier POS (/pos/*), and Manager Admin (/admin/*) strictly guarded by ProtectedRoute.&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#222222;&quot;&gt;• Dual Channel: Axios REST Client (axiosClient.js) for state commands + STOMP WebSocket (realtimeSync.js).&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#000000;strokeWidth=1.3;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1280" y="958" width="700" height="110" as="geometry"/></mxCell>
