        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml ROMS_Workflow1_Reservation_To_CheckIn\nskinparam monochrome true\nskinparam shadowing false\nskinparam defaultFontName \&quot;Segoe UI\&quot;\nskinparam defaultFontSize 12\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow true\nautonumber\n\ntitle SEQUENCE DIAGRAM: WORKFLOW 1 - FROM RESERVATION TO TABLE CHECK-IN\n\nactor \&quot;Customer\&quot; as Guest\nboundary \&quot;:ReservationPage\\n(Client Web)\&quot; as GuestUI\nboundary \&quot;:ManagerPortal\\n(Manager Web)\&quot; as MgrUI\ncontrol \&quot;:ReservationController\\n(REST API)\&quot; as ResCtrl\ncontrol \&quot;:ReservationService\\n(Service Layer)\&quot; as ResService\ncontrol \&quot;:TableService\\n(Service Layer)\&quot; as TableService\ndatabase \&quot;:Database\\n(SQL Server)\&quot; as DB\nqueue \&quot;:RealtimeService\\n(STOMP Broker)\&quot; as WS\nboundary \&quot;:KitchenKdsPage\\n(Kitchen KDS)\&quot; as KDS\n\n== PHASE 1: ONLINE RESERVATION &amp; PRE-ORDERED DISHES ==\nGuest -&gt; GuestUI: 1. Fill booking details &amp; select pre-ordered dishes (preOrderItems)\nactivate GuestUI\nGuestUI -&gt; ResCtrl: POST /api/customer/reservations\\nBody: CreateReservationRequest\nactivate ResCtrl\nResCtrl -&gt; ResService: createCustomerReservation(request)\nactivate ResService\n\nResService -&gt; ResService: Validate input (future timestamp, party size 1-20)\nloop For each pre-ordered dish\n    ResService -&gt; DB: menuItemRepository.findById(itemId)\n    activate DB\n    DB --&gt; ResService: MenuItem (unitPrice, isAvailable)\n    deactivate DB\n    ResService -&gt; ResService: Lock unit price at booking time (unitPrice)\nend\n\nResService -&gt; DB: Save Reservation (status=PENDING, code=\&quot;RES-yyyyMMdd-xxxx\&quot;)\\nSave ReservationItems\nactivate DB\nDB --&gt; ResService: Saved OK\ndeactivate DB\n\nResService -&gt; WS: notifyNewReservation(reservationId)\nactivate WS\nWS --&gt; MgrUI: STOMP: Audio chime &amp; \&quot;New Reservation\&quot; badge\ndeactivate WS\n\nResService --&gt; ResCtrl: ReservationResponse (PENDING, bookingCode)\ndeactivate ResService\nResCtrl --&gt; GuestUI: 201 Created { bookingCode }\ndeactivate ResCtrl\nGuestUI --&gt; Guest: Display reservation code &amp; Confirmation pending prompt\ndeactivate GuestUI\n\n== PHASE 2: MANAGER ASSIGNS TABLE &amp; ACTIVATES BUFFER TIME LOCK ==\nMgrUI -&gt; ResCtrl: 2. Query available tables (GET /available-tables)\nactivate MgrUI\nactivate ResCtrl\nResCtrl -&gt; ResService: getAvailableTablesForReservation(id)\nactivate ResService\nResService -&gt; DB: Find available tables matching Zone &amp; Capacity\nactivate DB\nDB --&gt; ResService: List of TableResponse\ndeactivate DB\nResService --&gt; ResCtrl: List&lt;TableResponse&gt;\ndeactivate ResService\nResCtrl --&gt; MgrUI: 200 OK\ndeactivate ResCtrl\n\nMgrUI -&gt; ResCtrl: 3. Assign table to guest (PUT /assign-table { tableId })\nactivate ResCtrl\nResCtrl -&gt; ResService: assignTableToReservation(id, request)\nactivate ResService\nResService -&gt; DB: reservation.setTable(table), status = CONFIRMED\nactivate DB\nDB --&gt; ResService: Saved OK\ndeactivate DB\nResService --&gt; ResCtrl: ReservationResponse (CONFIRMED)\ndeactivate ResService\nResCtrl --&gt; MgrUI: 200 OK\ndeactivate ResCtrl\ndeactivate MgrUI\n\nnote over TableService, DB\n  &lt;b&gt;Safe Table Buffer Time Lock:&lt;/b&gt;\n  Active from T-60&#39; to T+45&#39; relative to booking time.\n  Prevents assigning walk-in guests to this table:\n  &lt;i&gt;\&quot;TABLE CURRENTLY LOCKED FOR RESERVED PARTY\&quot;&lt;/i&gt;\nend note\n\n== PHASE 3: GUEST ARRIVAL &amp; ONE-TOUCH CHECK-IN ==\nGuest -&gt; MgrUI: 4. Arrive at restaurant, provide reservation code\nMgrUI -&gt; ResCtrl: 5. Click \&quot;Check-in Reservation\&quot; (POST /reservations/{id}/check-in)\nactivate MgrUI\nactivate ResCtrl\nResCtrl -&gt; ResService: checkInReservation(reservationId)\nactivate ResService\n\nResService -&gt; TableService: checkInReservationForTable(tableId, resId)\nactivate TableService\n\nTableService -&gt; DB: table.setStatus(TableStatus.OCCUPIED)\nTableService -&gt; DB: reservation.setStatus(ReservationStatus.COMPLETED)\nTableService -&gt; DB: Initialize new DiningSession (status=ACTIVE)\nactivate DB\nDB --&gt; TableService: Session Saved\ndeactivate DB\n\nopt #White Reservation includes pre-ordered dishes\n    TableService -&gt; DB: Create new Order (status=SUBMITTED, session)\n    TableService -&gt; DB: Create OrderItems &amp; deduct stock (decreaseStock)\n    activate DB\n    DB --&gt; TableService: Order Saved OK\n    deactivate DB\n    TableService -&gt; WS: notifyKitchenOrder(orderId, ORDER_NEW)\n    activate WS\n    WS --&gt; KDS: STOMP: Dispatch pre-orders ticket + Ding-Dong chime\n    deactivate WS\nend\n\nTableService -&gt; WS: notifyTableUpdate(tableId, OCCUPIED)\nactivate WS\nWS --&gt; MgrUI: STOMP: Table card turns orange (OCCUPIED)\ndeactivate WS\n\nTableService --&gt; ResService: Check-in Completed\ndeactivate TableService\nResService --&gt; ResCtrl: ReservationResponse (COMPLETED)\ndeactivate ResService\nResCtrl --&gt; MgrUI: 200 OK (Check-in Successful)\ndeactivate ResCtrl\nMgrUI --&gt; Guest: Escort guests to prepared table\ndeactivate MgrUI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GI_kzZTfXQQKf0uvmNMc-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
