        <UserObject label="SEQUENCE DIAGRAM: WORKFLOW 1 - FROM RESERVATION TO TABLE CHECK-IN" plantUmlId="title_112" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Segoe UI;" plantUmlBaseValue="SEQUENCE DIAGRAM: WORKFLOW 1 - FROM RESERVATION TO TABLE CHECK-IN" id="GI_kzZTfXQQKf0uvmNMc-114">
          <mxCell parent="GI_kzZTfXQQKf0uvmNMc-1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1">
