        <UserObject label="PHASE 3: GUEST ARRIVAL &amp;amp; ONE-TOUCH CHECK-IN" plantUmlId="div_74" plantUmlBaseStyle="rounded=0;fillColor=#EEEEEE;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacingRight=6;html=1;shadow=0;fontFamily=Segoe UI;" plantUmlBaseValue="PHASE 3: GUEST ARRIVAL &amp;amp; ONE-TOUCH CHECK-IN" id="GI_kzZTfXQQKf0uvmNMc-113">
