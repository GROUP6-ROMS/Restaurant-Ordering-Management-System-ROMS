<mxCell id="LEGEND_BOX" value="&lt;b&gt;CHÚ THÍCH KÝ HIỆU CHEN ERD:&lt;/b&gt;&amp;nbsp;&amp;nbsp;■ &lt;b&gt;Hình chữ nhật&lt;/b&gt;: Thực thể (Entity) &amp;nbsp;|&amp;nbsp; ◆ &lt;b&gt;Hình thoi&lt;/b&gt;: Mối quan hệ (Relationship) &amp;nbsp;|&amp;nbsp; &lt;b&gt;1 — N / N — 1&lt;/b&gt;: Quan hệ một - nhiều &amp;nbsp;|&amp;nbsp; &lt;b&gt;N — N&lt;/b&gt;: Quan hệ nhiều - nhiều (tách bảng khi sang CSDL vật lý) &amp;nbsp;|&amp;nbsp; &lt;b&gt;1 — 1&lt;/b&gt;: Quan hệ một - một (phiên ăn gắn đúng một hóa đơn thanh toán)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11.5;fontColor=#000000;fillColor=#F8F8F8;strokeColor=#000000;strokeWidth=1;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="1440" height="34" as="geometry"/></mxCell>
